# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# Cursor SDK (implementer, tester, and Cursor planner fallback)
CURSOR_API_KEY=
# Claude Agent SDK (Opus planner). From `claude setup-token`. Model/effort are hardcoded.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. Official remaining-usage % via Admin pooled-usage.
# CURSOR_ADMIN_API_KEY=
# CURSOR_ORGANIZATION_ID=
# Implementer (and Cursor planner fallback). Reasoning default high.
CURSOR_MODEL_IMPLEMENTER=grok-4.6
# CURSOR_MODEL_IMPLEMENTER_EFFORT=high
# Tester runs a 3-item checklist (highest volume, lowest reasoning). Default composer-2.5 / low.
CURSOR_MODEL_TESTER=composer-2.5
# CURSOR_MODEL_TESTER_EFFORT=low

# Game repo (required now; clone/fetch from milestone 2)
GAME_REPO_HTTPS_URL=
GAME_REPO_DIR=/game
GAME_REPO_BRANCH=master
GIT_AUTHOR_NAME=Egon
GIT_AUTHOR_EMAIL=egon@localhost

# GitHub (gh CLI + git HTTPS). Fine-grained PAT: Contents write, Pull requests write, Actions read, scoped to the game repo.
# Webhook secret matches the games-repo webhook (Pull requests + Workflow runs).
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Host GID of /dev/dri/renderD128 (stat -c %g /dev/dri/renderD128). Never card1.
# After GPU/PCI changes: ls -l /dev/dri/by-path/
# RENDER_GID=109

# Runtime
DATA_DIR=/data
WEB_SERVE_PORT=8080
FEATURES_HTTP_PORT=10001
# Public base URL for Discord catalog links and the GitHub webhook: {FEATURES_PUBLIC_URL}/github/webhook
# FEATURES_PUBLIC_URL=https://egon.mbuelow.dev
# Public URL of the exported Godot web game (catalog "Play the game" link).
# GAME_PUBLIC_URL=https://lets-vibe-together.mbuelow.dev
