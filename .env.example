DISCORD_BOT_TOKEN=your-discord-bot-token-here
# Discord user id of the bot's owner. Required — the owner is implicitly
# whitelisted and the only one who may use personal/dangerous tools.
OWNER_USER_ID=116152966632735745
# Comma-separated guild channel ids the bot participates in. DMs always work.
ALLOWED_CHANNEL_IDS=
OLLAMA_API_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# Small CPU-only fallback model (num_gpu: 0) used while the GPU is busy.
# Pull it once with `ollama pull llama3.2:3b`. Empty string disables it.
OLLAMA_UTILITY_MODEL=llama3.2:3b
# Windows monitor sidecar on the machine that hosts Ollama's GPU.
# Leave unset to disable GPU gating (local development).
WINDOWS_MONITOR_API_BASE_URL=http://127.0.0.1:11433
# 5-min average GPU load above this percentage counts as busy.
GPU_BUSY_THRESHOLD_PERCENT=40
GPU_POLL_INTERVAL_SECONDS=60
# Where SQLite state lives. In the container this is the /data volume;
# for local development point it somewhere writable, e.g. ./data.
DATA_DIR=./data
BOT_TIMEZONE=Europe/Berlin
# Obsidian Headless sync (§13). All three required for vault sync in Docker.
# Leave unset for local file-only vault under $DATA_DIR/vault.
OBSIDIAN_EMAIL=
OBSIDIAN_PASSWORD=
OBSIDIAN_VAULT_NAME=
# Only for end-to-end encrypted vaults.
OBSIDIAN_E2EE_PASSWORD=
# Optional override (default: $DATA_DIR/vault).
# OBSIDIAN_VAULT_DIR=./data/vault
# Voice transcription (whisper.cpp) and attachment download cap (§10).
WHISPER_MODEL=small
MAX_ATTACHMENT_MB=25
# Google Calendar (§12). Setup: dart run tool/google_calendar_setup.dart
# (needs GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET from a Desktop OAuth client).
# Optional write-target override (default: auto "Egon" calendar id in
# $DATA_DIR/google/config.json).
# GOOGLE_CALENDAR_ID=
