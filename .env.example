# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# Cursor SDK (required now; used from milestone 2)
CURSOR_API_KEY=
# Optional. Official remaining-usage % via Admin pooled-usage.
# CURSOR_ADMIN_API_KEY=
# CURSOR_ORGANIZATION_ID=
# Planner, implementer, and tester. Reasoning effort is always high.
CURSOR_MODEL=grok-4.6

# Game repo (required now; clone/fetch from milestone 2)
GAME_REPO_HTTPS_URL=
GAME_REPO_DIR=/game
GAME_REPO_BRANCH=master
GIT_AUTHOR_NAME=Egon
GIT_AUTHOR_EMAIL=egon@localhost

# GitHub (gh CLI + git HTTPS). Fine-grained PAT: Contents write, Pull requests write, Actions read, scoped to the game repo.
# Webhook secret matches the games-repo webhook (Pull requests + Workflow runs).
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Runtime
DATA_DIR=/data
WEB_SERVE_PORT=8080
FEATURES_HTTP_PORT=10001
# Public base URL for Discord catalog links and the GitHub webhook: {FEATURES_PUBLIC_URL}/github/webhook
# FEATURES_PUBLIC_URL=https://egon.mbuelow.dev
# Public URL of the exported Godot web game (catalog "Play the game" link).
# GAME_PUBLIC_URL=https://lets-vibe-together.mbuelow.dev
